<Page
    x:Class="Bookmark_Manager.PivotPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Bookmark_Manager"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Page.Transitions>
        <TransitionCollection>
            <NavigationThemeTransition>
                <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                    <CommonNavigationTransitionInfo IsStaggeringEnabled="True"/>
                </NavigationThemeTransition.DefaultNavigationTransitionInfo>
            </NavigationThemeTransition>
        </TransitionCollection>
    </Page.Transitions>

    <Grid>
        <Pivot x:Name="pivot" CommonNavigationTransitionInfo.IsStaggerElement="True">
            <Pivot.Title>
                <TextBlock Text="BOOKMARK MANAGER" Foreground="{ThemeResource PhoneAccentBrush}" FontWeight="SemiBold" FontSize="12" CharacterSpacing="50"/>
            </Pivot.Title>

            <PivotItem Header="bookmarks" Margin="19,10,19,0">
                <GridView x:Name="BookmarksGridView"
                          IsItemClickEnabled="True"
                          ItemClick="BookmarksGridView_ItemClick"
                          SelectionChanged="BookmarksGridView_SelectionChanged"
                          SizeChanged="Grid_SizeChanged"
                          Padding="0"
                          Margin="0">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Margin" Value="2"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Grid Background="{ThemeResource PhoneAccentBrush}"
                                  Holding="BookmarkGrid_Holding">
                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Opacity="0.35" />

                                <Grid Margin="8" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Title}" Grid.Row="0" FontWeight="SemiBold" FontSize="14" MaxLines="2" TextWrapping="Wrap" Foreground="White" LineStackingStrategy="MaxHeight"/>
                                    <TextBlock Text="{Binding Snippet}" Grid.Row="1" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="White" Opacity="0.8" LineStackingStrategy="MaxHeight"/>
                                </Grid>

                                <Border VerticalAlignment="Bottom" Background="#AA000000" Padding="6,4">
                                    <TextBlock Text="{Binding Url}" FontSize="11" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </PivotItem>

            <PivotItem Header="categories" Margin="19,10,19,0">
                <GridView x:Name="CategoriesGridView"
                          IsItemClickEnabled="True"
                          ItemClick="CategoriesGridView_ItemClick"
                          SizeChanged="Grid_SizeChanged"
                          Padding="0"
                          Margin="0">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Margin" Value="2"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Grid Background="{ThemeResource PhoneAccentBrush}"
                                  Holding="CategoryGrid_Holding">
                                <Grid Margin="10" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </PivotItem>
        </Pivot>

        <Grid x:Name="CategorySelectionOverlay" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Visibility="Collapsed" Canvas.ZIndex="100">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="19,12,19,20">
                <TextBlock Text="BOOKMARK MANAGER" Style="{ThemeResource TitleTextBlockStyle}" Foreground="{ThemeResource PhoneAccentBrush}"/>
                <TextBlock Text="select category" Style="{ThemeResource HeaderTextBlockStyle}" CharacterSpacing="{ThemeResource PivotHeaderItemCharacterSpacing}"/>
            </StackPanel>

            <ListView x:Name="FullScreenCategoriesListView" Grid.Row="1" Margin="19,0,19,0" IsItemClickEnabled="True" ItemClick="FullScreenCategoriesListView_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" FontSize="26" Margin="5,15" Foreground="{ThemeResource ApplicationForegroundThemeBrush}" FontWeight="Light"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>

    <Page.BottomAppBar>
        <CommandBar x:Name="MainCommandBar">
            <AppBarButton x:Name="AddBookmarkButton" Icon="Add" Label="add bookmark" Click="AddBookmarkButton_Click" />
            <AppBarButton x:Name="AddCategoryButton" Icon="Folder" Label="add category" Click="AddCategoryButton_Click" />
            <AppBarButton x:Name="SearchButton" Icon="Find" Label="search" Click="SearchButton_Click" />
            <AppBarButton x:Name="AddToCategoryButton" Icon="SaveLocal" Label="categorize" Visibility="Collapsed" Click="AddToCategoryButton_Click" />
            <AppBarButton x:Name="AboutButton" Icon="Help" Label="about" Click="AboutButton_Click" />
            <AppBarButton x:Name="CancelSelectionButton" Icon="Cancel" Label="cancel" Visibility="Collapsed" Click="CancelSelectionButton_Click" />
        </CommandBar>
    </Page.BottomAppBar>
</Page>
